/* German localization for CalSync. Keys are the English source strings. */

/* Calendar access */
"Calendar Access" = "Kalenderzugriff";
"CalSync needs full access to your calendars to read events from one calendar and copy them to another." = "CalSync benötigt vollen Zugriff auf die Kalender, um Termine aus einem Kalender zu lesen und in einen anderen zu kopieren.";
"Allow Access" = "Zugriff erlauben";
"No Calendar Access" = "Kein Kalenderzugriff";
"Allow CalSync full access to calendars in Settings to copy events." = "CalSync benötigt in den Einstellungen vollen Zugriff auf Kalender, um Termine zu kopieren.";
"Open Settings" = "Einstellungen öffnen";

/* Job list */
"Sync" = "Synchronisieren";
"No Syncs" = "Keine Synchronisierungen";
"Add a sync to copy events from one or more calendars, such as Outlook, to another, such as iCloud." = "Füge eine Synchronisierung hinzu, um Termine aus einem oder mehreren Kalendern, etwa Outlook, in einen anderen, etwa iCloud, zu kopieren.";
"Add Calendar" = "Kalender hinzufügen";
"Remove Calendar" = "Kalender entfernen";
"Choose one or more source calendars." = "Wähle einen oder mehrere Quellkalender.";
"No source" = "Keine Quelle";
"Add more than one calendar to merge them. Meetings that appear in more than one source are copied once, using the first source's details." = "Füge mehr als einen Kalender hinzu, um sie zusammenzuführen. Termine, die in mehreren Quellen vorkommen, werden nur einmal kopiert; dabei gelten die Angaben der ersten Quelle.";
"Add Sync" = "Synchronisierung hinzufügen";
"Sync All" = "Alle synchronisieren";
"Not synced yet" = "Noch nicht synchronisiert";
"Missing calendar" = "Kalender fehlt";

/* Split layout */
"No Sync Selected" = "Keine Synchronisierung ausgewählt";
"Select a sync to edit it." = "Wähle eine Synchronisierung zum Bearbeiten aus.";

