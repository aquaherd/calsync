/* Status and errors */
"Busy" = "Beschäftigt";
"%lld added" = "%lld hinzugefügt";
"%lld updated" = "%lld aktualisiert";
"%lld removed" = "%lld entfernt";
"%lld failed" = "%lld fehlgeschlagen";
"Source calendar not found." = "Quellkalender nicht gefunden.";
"Source calendar “%@” not found." = "Quellkalender „%@“ nicht gefunden.";
"Destination calendar not found." = "Zielkalender nicht gefunden.";
"Destination calendar is read-only." = "Der Zielkalender ist schreibgeschützt.";
"Source and destination must differ." = "Quelle und Ziel müssen unterschiedlich sein.";

/* Safety and calendar changes */
"Calendars changed" = "Kalender geändert";
"Remove Old Copies" = "Alte Kopien entfernen";
"Keep Old Copies" = "Alte Kopien behalten";
"Copies already in the destination calendar stay unless you remove them. CalSync can no longer manage them afterwards." = "Bereits in den Zielkalender kopierte Termine bleiben, sofern du sie nicht entfernst. CalSync kann sie danach nicht mehr verwalten.";
"Removal Stopped" = "Entfernen gestoppt";
"Remove Anyway" = "Trotzdem entfernen";
"“%@” would remove copied events (%lld) because a source calendar looks empty or much smaller. Check the source account first." = "„%@“ würde kopierte Termine entfernen (%lld), weil ein Quellkalender leer oder deutlich kleiner aussieht. Prüfe zuerst das Quellkonto.";
"Stopped before removing copied events (%lld) because a source calendar looks empty or much smaller. Check the source account, then confirm the removal." = "Vor dem Entfernen kopierter Termine gestoppt (%lld), weil ein Quellkalender leer oder deutlich kleiner aussieht. Prüfe das Quellkonto und bestätige dann das Entfernen.";
"CalSync Storage" = "CalSync-Speicher";
"Could not read the saved syncs. The previous file was kept as %@." = "Die gesicherten Synchronisierungen konnten nicht gelesen werden. Die vorherige Datei wurde als %@ behalten.";
"CalSync could not save its syncs. Check that the device has free storage." = "CalSync konnte die Synchronisierungen nicht sichern. Prüfe, ob auf dem Gerät genügend Speicher frei ist.";
"A copied event could not be found and will be recreated." = "Eine Kopie wurde nicht gefunden und wird neu erstellt.";
"A copied event could not be saved." = "Eine Kopie konnte nicht gesichert werden.";
"Last Sync" = "Letzte Synchronisierung";
"Enabled syncs run when the app opens and periodically in the background. A very large removal is stopped until you confirm it." = "Aktivierte Synchronisierungen laufen beim Öffnen der App und regelmäßig im Hintergrund. Sehr große Löschvorgänge werden gestoppt, bis du sie bestätigst.";

/* Teams links */
"When Copy URL is off, Teams join links and their join boilerplate are removed from notes and location too." = "Wenn „URL kopieren“ aus ist, werden Teams-Beitrittslinks und die zugehörigen Beitrittstexte auch aus Notizen und Ort entfernt.";
