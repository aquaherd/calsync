"Create" = "Erstellen";
"No account can create calendars. Add an iCloud account in Settings." = "Kein Konto kann Kalender erstellen. Füge in den Einstellungen ein iCloud-Konto hinzu.";
"New calendars are created in iCloud or On My iPhone. Share one in Calendar to let someone else see it." = "Neue Kalender werden in iCloud oder „Auf meinem iPhone“ erstellt. Teile einen Kalender in der Kalender-App, damit ihn andere sehen.";
"Calendars in On My iPhone stay on this device. To share a calendar, create it in iCloud and share it in Calendar." = "Kalender unter „Auf meinem iPhone“ bleiben auf diesem Gerät. Um einen Kalender zu teilen, erstelle ihn in iCloud und teile ihn in der Kalender-App.";
"Enter a name for the new calendar." = "Gib einen Namen für den neuen Kalender ein.";
"A calendar with this name already exists in that account." = "In diesem Konto gibt es bereits einen Kalender mit diesem Namen.";
"The account for the new calendar is no longer available." = "Das Konto für den neuen Kalender ist nicht mehr verfügbar.";
"This account cannot create calendars. Choose iCloud or On My iPhone." = "Dieses Konto kann keine Kalender erstellen. Wähle iCloud oder „Auf meinem iPhone“.";
"Outlook calendars appear here once your Outlook or Exchange account is added under Settings › Apps › Calendar › Calendar Accounts." = "Outlook-Kalender erscheinen hier, sobald das Outlook- oder Exchange-Konto unter Einstellungen › Apps › Kalender › Kalenderkonten hinzugefügt ist.";
